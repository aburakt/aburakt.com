---
import BaseLayout from './BaseLayout.astro'
import Header from '@/components/astro/Header.astro'
import Footer from '@/components/astro/Footer.astro'

interface Props {
  title?: string
  description?: string
  zone?: string
  type?: 'website' | 'article'
  image?: string
  imageAlt?: string
  jsonLd?: Record<string, unknown>
  markdown?: string
  alternates?: boolean
}

const { zone, ...seo } = Astro.props
---

<BaseLayout {...seo}>
  <div class="relative flex min-h-screen w-full flex-col">
    <Header />
    <main id="main" tabindex="-1" class="flex-auto" data-zone={zone}>
      <slot />
    </main>
    <Footer />
  </div>
</BaseLayout>
