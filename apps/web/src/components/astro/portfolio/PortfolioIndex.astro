---
import Container from "@/components/astro/Container.astro";
import { KIND_LABEL, type Locale, PROJECTS, projectPath } from "@/data/portfolio";
import { imageUrl, liveCount, UI } from "@/lib/portfolio";
import Shot from "./Shot.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = UI[locale];
---

<Container class="mt-16 sm:mt-24">
  <div class="mb-6 flex items-center gap-2 text-xs text-green-700">
    <span class="text-green-500">$</span>
    <span>ls -la ~/portfolio/</span>
  </div>

  <h1 class="text-xl font-bold leading-tight text-cyan-400 text-glow-cyan sm:text-2xl">{ui.title}</h1>
  <p class="mt-4 max-w-3xl text-sm leading-relaxed text-green-500">{ui.intro}</p>
  <p class="mt-3 text-xs text-green-600"># {ui.stats(liveCount, PROJECTS.length)} · {ui.ministryNote}</p>

  <ul class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2" role="list">
    {
      PROJECTS.map((p, i) => (
        <li>
          <a
            href={projectPath(locale, p.slug)}
            class="group block h-full rounded-lg border border-green-900/20 bg-green-950/10 p-3 transition hover:border-cyan-500/40 hover:bg-green-950/30"
          >
            <Shot
              src={imageUrl(p)}
              alt=""
              label={p.url ? p.url.replace(/^https:\/\//, '') : `~/${p.slug}`}
              width={1200}
              height={750}
              eager={i < 2}
            />
            <div class="mt-4 px-1 pb-1">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
                <span class="text-amber-400">{KIND_LABEL[locale][p.kind]}</span>
                <span class="text-green-600">{p.year}</span>
              </div>
              <h2 class="mt-1 text-base font-semibold text-cyan-400 group-hover:text-glow-cyan">{p.name}</h2>
              <p class="mt-2 text-xs leading-relaxed text-green-500">{p[locale].summary}</p>
              <p class="mt-3 text-xs text-green-600">{p.stack.slice(0, 4).join(' · ')}</p>
              <span class="mt-3 inline-block text-xs text-cyan-500">
                cd {p.slug}/ <span class="sr-only">{p.name}</span> <span aria-hidden="true">-&gt;</span> {ui.open}
              </span>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</Container>
